generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres.
// DATABASE_URL -> Supavisor transaction pooler (port 6543), used by the app.
// DIRECT_URL   -> direct connection (port 5432), used by `prisma migrate`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model SharedCart {
  id        String   @id @default(cuid())
  code      String   @unique
  shop      String
  // Snapshot of the cart at share time: variant id, quantity, properties, plus
  // title/image so the redeem page renders without an API call.
  items     Json
  createdAt DateTime @default(now())

  @@index([shop])
}
